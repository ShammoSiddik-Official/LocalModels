{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"script","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"1adddff3-f64e-47cb-b822-ab945772762a","cell_type":"code","source":"import os, shutil, subprocess, time, urllib.request, json, re, queue, threading\nfrom pathlib import Path\n\nOLLAMA_URL=\"http://127.0.0.1:11434\"\nOLLAMA_MODELS=Path(\"/kaggle/working/ollama-models\")\nSOURCE_MODEL=\"hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q4_K_M\"\nMTP_MODEL=\"qwen3.8-27b-uncensored-mtp\"\nNUM_CTX=65536\nDRAFT_TOKENS=2\nOLLAMA_MODELS.mkdir(parents=True,exist_ok=True)\n\n# Install Ollama + cloudflared dependencies\nsubprocess.run(\"apt-get update -qq && apt-get install -y -qq zstd curl >/dev/null\",shell=True,check=True)\nif not shutil.which(\"ollama\"):\n    subprocess.run(\"curl -fsSL https://ollama.com/install.sh | sh >/dev/null\",shell=True,check=True)\nif not shutil.which(\"cloudflared\"):\n    subprocess.run('curl -fsSL \"https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb\" -o /tmp/cloudflared.deb && dpkg -i /tmp/cloudflared.deb >/dev/null',shell=True,check=True)\n\nOLLAMA_BIN=shutil.which(\"ollama\")\nenv=os.environ.copy()\nenv.update({\"OLLAMA_HOST\":\"127.0.0.1:11434\",\"OLLAMA_MODELS\":str(OLLAMA_MODELS),\"OLLAMA_KEEP_ALIVE\":\"-1\",\"OLLAMA_FLASH_ATTENTION\":\"1\",\"OLLAMA_KV_CACHE_TYPE\":\"q8_0\",\"OLLAMA_CONTEXT_LENGTH\":str(NUM_CTX),\"OLLAMA_NUM_PARALLEL\":\"1\",\"OLLAMA_MAX_LOADED_MODELS\":\"1\"})\n\ndef ready():\n    try: urllib.request.urlopen(OLLAMA_URL+\"/api/tags\",timeout=2).close(); return True\n    except: return False\n\nif not ready():\n    log=open(\"/tmp/ollama.log\",\"a\")\n    ollama=subprocess.Popen([OLLAMA_BIN,\"serve\"],env=env,stdout=log,stderr=subprocess.STDOUT)\n    for _ in range(90):\n        if ready(): break\n        time.sleep(1)\n    else: raise RuntimeError(\"Ollama failed to start\")\n\n# Pull base model (retry HF/Xet redirect workaround used by original notebook)\nr=subprocess.run([OLLAMA_BIN,\"pull\",SOURCE_MODEL],env=env)\nif r.returncode:\n    subprocess.run([OLLAMA_BIN,\"pull\",\"--insecure\",SOURCE_MODEL],env=env,check=True)\n\n# Create MTP model\npayload={\"model\":MTP_MODEL,\"from\":SOURCE_MODEL,\"parameters\":{\"draft_num_predict\":DRAFT_TOKENS,\"num_ctx\":NUM_CTX},\"stream\":False}\nreq=urllib.request.Request(OLLAMA_URL+\"/api/create\",data=json.dumps(payload).encode(),headers={\"Content-Type\":\"application/json\"},method=\"POST\")\nwith urllib.request.urlopen(req,timeout=600) as r: r.read()\n\n# Load/pin and verify inference\npayload={\"model\":MTP_MODEL,\"prompt\":\"Reply exactly: KAGGLE_QWEN_OK\",\"stream\":False,\"keep_alive\":-1,\"options\":{\"draft_num_predict\":DRAFT_TOKENS,\"num_ctx\":NUM_CTX}}\nreq=urllib.request.Request(OLLAMA_URL+\"/api/generate\",data=json.dumps(payload).encode(),headers={\"Content-Type\":\"application/json\"},method=\"POST\")\nwith urllib.request.urlopen(req,timeout=900) as r:\n    result=json.loads(r.read())\nif \"KAGGLE_QWEN_OK\" not in result.get(\"response\",\"\"):\n    raise RuntimeError(\"Qwen inference verification failed\")\n\n# Start Quick Tunnel and print only the URL\ncf=subprocess.Popen([\"cloudflared\",\"tunnel\",\"--no-autoupdate\",\"--protocol\",\"http2\",\"--edge-ip-version\",\"4\",\"--url\",OLLAMA_URL,\"--http-host-header\",\"localhost:11434\"],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,bufsize=1)\nurl=None\nend=time.monotonic()+90\nwhile time.monotonic()<end:\n    line=cf.stdout.readline()\n    m=re.search(r\"https://[a-z0-9-]+\\\\.trycloudflare\\\\.com\",line or \"\")\n    if m: url=m.group(0); break\n    if cf.poll() is not None: break\nif not url: raise RuntimeError(\"Cloudflare tunnel URL not obtained\")\nprint(url,flush=True)\n\n# Keep this batch kernel alive while the tunnel/server are alive.\n# Kaggle's own runtime/session limits still apply.\nwhile cf.poll() is None and ollama.poll() is None:\n    time.sleep(30)\n","metadata":{},"outputs":[],"execution_count":null}]}