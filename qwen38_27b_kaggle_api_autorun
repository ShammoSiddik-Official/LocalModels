import os, shutil, subprocess, time, urllib.request, json, re, queue, threading
from pathlib import Path

OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODELS=Path("/kaggle/working/ollama-models")
SOURCE_MODEL="hf.co/JonathanColetti/Qwen3.8-27B-Uncensored-GGUF:Q4_K_M"
MTP_MODEL="qwen3.8-27b-uncensored-mtp"
NUM_CTX=65536
DRAFT_TOKENS=2
OLLAMA_MODELS.mkdir(parents=True,exist_ok=True)

# Install Ollama + cloudflared dependencies
subprocess.run("apt-get update -qq && apt-get install -y -qq zstd curl >/dev/null",shell=True,check=True)
if not shutil.which("ollama"):
    subprocess.run("curl -fsSL https://ollama.com/install.sh | sh >/dev/null",shell=True,check=True)
if not shutil.which("cloudflared"):
    subprocess.run('curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb" -o /tmp/cloudflared.deb && dpkg -i /tmp/cloudflared.deb >/dev/null',shell=True,check=True)

OLLAMA_BIN=shutil.which("ollama")
env=os.environ.copy()
env.update({"OLLAMA_HOST":"127.0.0.1:11434","OLLAMA_MODELS":str(OLLAMA_MODELS),"OLLAMA_KEEP_ALIVE":"-1","OLLAMA_FLASH_ATTENTION":"1","OLLAMA_KV_CACHE_TYPE":"q8_0","OLLAMA_CONTEXT_LENGTH":str(NUM_CTX),"OLLAMA_NUM_PARALLEL":"1","OLLAMA_MAX_LOADED_MODELS":"1"})

def ready():
    try: urllib.request.urlopen(OLLAMA_URL+"/api/tags",timeout=2).close(); return True
    except: return False

if not ready():
    log=open("/tmp/ollama.log","a")
    ollama=subprocess.Popen([OLLAMA_BIN,"serve"],env=env,stdout=log,stderr=subprocess.STDOUT)
    for _ in range(90):
        if ready(): break
        time.sleep(1)
    else: raise RuntimeError("Ollama failed to start")

# Pull base model (retry HF/Xet redirect workaround used by original notebook)
r=subprocess.run([OLLAMA_BIN,"pull",SOURCE_MODEL],env=env)
if r.returncode:
    subprocess.run([OLLAMA_BIN,"pull","--insecure",SOURCE_MODEL],env=env,check=True)

# Create MTP model
payload={"model":MTP_MODEL,"from":SOURCE_MODEL,"parameters":{"draft_num_predict":DRAFT_TOKENS,"num_ctx":NUM_CTX},"stream":False}
req=urllib.request.Request(OLLAMA_URL+"/api/create",data=json.dumps(payload).encode(),headers={"Content-Type":"application/json"},method="POST")
with urllib.request.urlopen(req,timeout=600) as r: r.read()

# Load/pin and verify inference
payload={"model":MTP_MODEL,"prompt":"Reply exactly: KAGGLE_QWEN_OK","stream":False,"keep_alive":-1,"options":{"draft_num_predict":DRAFT_TOKENS,"num_ctx":NUM_CTX}}
req=urllib.request.Request(OLLAMA_URL+"/api/generate",data=json.dumps(payload).encode(),headers={"Content-Type":"application/json"},method="POST")
with urllib.request.urlopen(req,timeout=900) as r:
    result=json.loads(r.read())
if "KAGGLE_QWEN_OK" not in result.get("response",""):
    raise RuntimeError("Qwen inference verification failed")

# Start Quick Tunnel and print only the URL
cf=subprocess.Popen(["cloudflared","tunnel","--no-autoupdate","--protocol","http2","--edge-ip-version","4","--url",OLLAMA_URL,"--http-host-header","localhost:11434"],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,bufsize=1)
url=None
end=time.monotonic()+90
while time.monotonic()<end:
    line=cf.stdout.readline()
    m=re.search(r"https://[a-z0-9-]+\\.trycloudflare\\.com",line or "")
    if m: url=m.group(0); break
    if cf.poll() is not None: break
if not url: raise RuntimeError("Cloudflare tunnel URL not obtained")
print(url,flush=True)

# Keep this batch kernel alive while the tunnel/server are alive.
# Kaggle's own runtime/session limits still apply.
while cf.poll() is None and ollama.poll() is None:
    time.sleep(30)
